# EditorConfig — https://editorconfig.org
# Menjaga konsistensi format dasar lintas editor tanpa memaksa formatter tertentu.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py}]
indent_size = 4

[*.{js,json,yml,yaml,html,css}]
indent_size = 2

[*.md]
# Markdown sering memakai dua spasi di akhir baris untuk line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{c,h}]
indent_size = 4
