# CukAccount UI DSL v1: safe directives consumed by tools/cuk_ui_runtime.py.
# @app CukAccount
# @theme system
# @navigation home:Beranda,transactions:Jurnal,ledger:Buku Besar,reports:Laporan,periods:Periode
# @screen home:Ringkasan Keuangan
# @text hero:Keuangan rapi, pikiran nggak mumet.
# @text summary:Catat transaksi, periksa keseimbangan, dan tinjau laporan.
# @metric total_debit:Total Debit:IDR
# @metric total_credit:Total Kredit:IDR
# @metric difference:Selisih Jurnal:IDR
# @metric row_count:Baris Jurnal:count
# @end
# @screen transactions:Jurnal Umum
# @field date:Tanggal:date:required
# @field description:Keterangan:text:required
# @field account:Akun:select:required
# @field category:Kategori:select:required
# @field debit:Debit Rupiah:integer:min=0
# @field credit:Kredit Rupiah:integer:min=0
# @action add_line:Tambah Baris
# @action validate:Validasi Jurnal
# @action save_draft:Simpan Draft
# @end
# @screen ledger:Buku Besar
# @filter account:Akun:select
# @filter start_date:Dari Tanggal:date
# @filter end_date:Sampai Tanggal:date
# @end
# @screen reports:Laporan Keuangan
# @report trial_balance:Neraca Saldo
# @report income_statement:Laba Rugi
# @report balance_sheet:Posisi Keuangan
# @end
# @screen periods:Periode Akuntansi
# @action preview_close:Tinjau Penutupan Periode
# @end
jancuk
fungsi route_for(menu)
    njir menu == "home"
        balek "BERANDA"
    kampret
        njir menu == "transactions"
            balek "TRANSAKSI"
        kampret
            njir menu == "ledger"
                balek "BUKU_BESAR"
            kampret
                njir menu == "reports"
                    balek "LAPORAN"
                kampret
                    njir menu == "periods"
                        balek "PERIODE"
                    kampret
                        balek "RUTE_TIDAK_DIKENAL"
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi
fungsi validate_journal_form(total_debit, total_kredit, jumlah_baris, akun_valid, periode_terbuka)
    njir bukan akun_valid
        balek "AKUN_TIDAK_VALID"
    selesai njir
    njir bukan periode_terbuka
        balek "PERIODE_TERTUTUP"
    selesai njir
    njir jumlah_baris < 2
        balek "MINIMAL_DUA_BARIS"
    selesai njir
    njir total_debit <= 0 atau total_kredit <= 0
        balek "NILAI_DEBIT_KREDIT_HARUS_POSITIF"
    selesai njir
    njir total_debit != total_kredit
        balek "JURNAL_TIDAK_SEIMBANG"
    kampret
        balek "FORMULIR_VALID"
    selesai njir
selesai fungsi
hedeh route_for("home")
hedeh route_for("transactions")
hedeh route_for("ledger")
hedeh route_for("reports")
hedeh route_for("periods")
hedeh validate_journal_form(100, 100, 2, benar, benar)
hedeh validate_journal_form(100, 99, 2, benar, benar)
selesai jancuk
