# CukAccount domain rules in PusingCuk 0.6-dev.
# This file intentionally uses only documented core syntax so it can run
# on the reference interpreter without pretending module/SQLite support exists.
jancuk

fungsi persamaan_akuntansi(aset, liabilitas, ekuitas)
    njir aset < 0 atau liabilitas < 0 atau ekuitas < 0
        balek "INPUT_TIDAK_VALID"
    selesai njir
    njir aset == liabilitas + ekuitas
        balek "PERSAMAAN_SEIMBANG"
    kampret
        balek "PERSAMAAN_TIDAK_SEIMBANG"
    selesai njir
selesai fungsi

fungsi validasi_jurnal(total_debit, total_kredit, jumlah_baris)
    njir total_debit < 0 atau total_kredit < 0 atau jumlah_baris < 2
        balek "JURNAL_TIDAK_VALID"
    selesai njir
    njir total_debit == 0 atau total_kredit == 0
        balek "JURNAL_TIDAK_VALID"
    selesai njir
    njir total_debit == total_kredit
        balek "JURNAL_SEIMBANG"
    kampret
        balek "JURNAL_TIDAK_SEIMBANG"
    selesai njir
selesai fungsi

fungsi saldo_normal(kategori, debit, kredit)
    njir debit < 0 atau kredit < 0
        balek "INPUT_TIDAK_VALID"
    selesai njir
    njir kategori == "Aset" atau kategori == "Beban"
        balek debit - kredit
    kampret
        njir kategori == "Liabilitas" atau kategori == "Ekuitas" atau kategori == "Pendapatan"
            balek kredit - debit
        kampret
            balek "KATEGORI_TIDAK_DIKENAL"
        selesai njir
    selesai njir
selesai fungsi

# Deterministic smoke/regression cases; output is machine-readable.
hedeh persamaan_akuntansi(1000, 300, 700)
hedeh persamaan_akuntansi(1000, 300, 699)
hedeh persamaan_akuntansi(-1, 0, 0)
hedeh validasi_jurnal(1000, 1000, 2)
hedeh validasi_jurnal(1000, 999, 2)
hedeh validasi_jurnal(0, 0, 1)
hedeh saldo_normal("Aset", 1200, 200)
hedeh saldo_normal("Pendapatan", 200, 1200)
hedeh saldo_normal("AkunLiar", 1, 1)

selesai jancuk
