{
  "name": "pusingcuk-accounting",
  "version": "0.1.0",
  "description": "Offline-first Indonesian accounting learning desktop app",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:rules": "cd ../.. && python -m compiler.js_backend examples/accounting/aturan_ringkasan.cuk --module -o apps/accounting/accounting-rules.generated.js",
    "prestart": "npm run build:rules",
    "pretest:core": "npm run build:rules",
    "start": "electron .",
    "test:core": "node --test test-accounting-core.cjs && cd ../.. && python -m unittest tests.test_cuk_ui_runtime tests.test_platform_bridge tests.test_sqlite_store tests.test_typed_bridge_integration tests.test_diagnostic_repair_loop -v",
    "predist:win": "npm run build:rules",
    "dist:win": "electron-builder --win portable",
    "render:ui": "cd ../.. && python tools/cuk_ui_runtime.py apps/accounting/cukaccount_frontend.cuk --output apps/accounting/dist/index.html",
    "test:ui": "python -m unittest tests.test_cuk_ui_runtime tests.test_platform_bridge -v",
    "pretest:ui": "npm run render:ui",
    "prestart:cuk-ui": "npm run render:ui",
    "start:cuk-ui": "electron cuk-ui-main.cjs"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "id.pusingcuk.accounting",
    "productName": "PusingCuk Accounting",
    "asar": true,
    "files": [
      "main.cjs",
      "index.html",
      "accounting-core.js",
      "accounting-rules.generated.js",
      "package.json",
      "dist/index.html",
      "platform_bridge.py",
      "sqlite_store.py",
      "cuk-ui-main.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PusingCuk-Accounting-${version}.${ext}"
    }
  }
}
