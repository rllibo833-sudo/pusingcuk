{
  "name": "pusingcuk-accounting",
  "version": "0.1.0",
  "description": "Offline-first Indonesian accounting learning desktop app",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:rules": "cd ../.. && python -m compiler.js_backend examples/accounting/rekap_keuangan.cuk --module -o apps/accounting/accounting-rules.generated.js",
    "prestart": "npm run build:rules",
    "pretest:core": "npm run build:rules",
    "start": "electron .",
    "test:core": "node --test test-accounting-core.cjs",
    "predist:win": "npm run build:rules",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {"electron": "33.2.1", "electron-builder": "25.1.8"},
  "build": {"appId": "id.pusingcuk.accounting", "productName": "PusingCuk Accounting", "asar": true, "files": ["main.cjs", "index.html", "accounting-core.js", "accounting-rules.generated.js", "package.json"], "win": {"target": ["portable"], "artifactName": "PusingCuk-Accounting-${version}.${ext}"}}
}
