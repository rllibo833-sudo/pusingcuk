# Aturan akuntansi bersama untuk aplikasi PusingCuk Accounting.
# Hasil fungsi: [laba_periode, ekuitas_akhir, selisih_persamaan_akuntansi].
jancuk
fungsi hitung_ringkasan(pendapatan, beban, aset, liabilitas, ekuitas)
    lah laba = pendapatan - beban
    lah ekuitas_akhir = ekuitas + laba
    lah selisih_posisi = aset - liabilitas - ekuitas_akhir
    balek [laba, ekuitas_akhir, selisih_posisi]
selesai fungsi
selesai jancuk
