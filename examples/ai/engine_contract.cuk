# Kontrak authoring PusingCuk AI v1.
# Contoh lokal: tidak memanggil model, jaringan, shell, database, atau filesystem.

jancuk

# Prompt/context: fungsi murni menerima seluruh konteks secara eksplisit.
fungsi susun_prompt(konteks, pertanyaan)
    balek "Gunakan konteks terverifikasi saja. Konteks: " + konteks + " Pertanyaan: " + pertanyaan
selesai fungsi

# Aturan deterministik murni. Host harus memvalidasi tipe dan ukuran input lebih dulu.
fungsi status_keluaran(jawaban)
    njir panjang(jawaban) < 1
        balek "OUTPUT_KOSONG"
    kampret
        njir panjang(jawaban) > 4000
            balek "OUTPUT_PERLU_DIPOTONG"
        kampret
            balek "OUTPUT_MENUNGGU_TINJAUAN"
        selesai njir
    selesai njir
selesai fungsi

# Status bukti kode .cuk: kompilasi saja tidak membuktikan perilaku runtime.
# Nilai status berasal dari host/test runner; fungsi ini tidak mengeksekusi kode.
fungsi status_bukti_kode(status_kompilasi, status_runtime)
    njir status_kompilasi == "input_tidak_valid"
        balek "SOURCE_INPUT_TIDAK_VALID"
    kampret
        njir status_kompilasi == "terlalu_besar"
            balek "SOURCE_MELEBIHI_BATAS"
        kampret
            njir status_kompilasi == "ditolak"
        balek "SOURCE_DITOLAK_COMPILER"
    kampret
        njir status_kompilasi != "lulus"
            balek "STATUS_KOMPILASI_TIDAK_VALID"
        kampret
            njir status_runtime == "lulus"
                balek "RUNTIME_TERUJI"
            kampret
                njir status_runtime == "belum_dijalankan"
                    balek "KOMPILASI_LOLOS_RUNTIME_BELUM_DIUJI"
                kampret
                    njir status_runtime == "gagal"
                        balek "RUNTIME_GAGAL"
                    kampret
                        balek "STATUS_RUNTIME_TIDAK_VALID"
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
        selesai njir
    selesai njir
selesai fungsi

# Data ini adalah deklarasi, bukan keyword bahasa baru.
lah prompt_definisi = {"id": "assistant.answer.v1", "system": "Jawab hanya dari konteks yang diberikan dan tandai ketidakpastian.", "context_label": "Konteks: ", "question_label": "Pertanyaan: ", "max_context_chars": 8000}

lah rule_definisi = {"id": "assistant.output-review.v1", "entrypoint": "status_keluaran", "input_fields": ["jawaban"], "input_type": "string", "max_input_chars": 4000, "capabilities": []}

# Handler harus sudah terdaftar di library/ai_tools.py; deklarasi .cuk
# tidak membuat izin atau mengeksekusi tool secara otomatis.
lah tool_knowledge_search = {"id": "knowledge_search", "handler": "host:knowledge_search", "input_fields": ["query", "limit"], "capabilities": ["knowledge:read"], "max_query_chars": 300, "max_results": 3}

hedeh status_keluaran("Jawaban berbasis sumber.")
hedeh status_bukti_kode("input_tidak_valid", "belum_dijalankan")
hedeh status_bukti_kode("terlalu_besar", "belum_dijalankan")
hedeh status_bukti_kode("lulus", "belum_dijalankan")
hedeh status_bukti_kode("lulus", "lulus")
hedeh status_bukti_kode("ditolak", "belum_dijalankan")
hedeh status_bukti_kode("lulus", "gagal")
hedeh status_bukti_kode("gagal", "belum_dijalankan")
hedeh status_bukti_kode("lulus", "status_tidak_dikenal")
hedeh status_bukti_kode("status_tidak_dikenal", "lulus")
hedeh susun_prompt("Kontrak runtime lokal.", "Apa batas tool?")

selesai jancuk
