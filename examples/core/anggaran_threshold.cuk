# CORE contract v1: pure, deterministic budget threshold rule.
# No filesystem, network, database, process, or secret capabilities are needed.

jancuk

fungsi status_anggaran(nominal, batas)
    njir nominal < 0 atau batas < 0
        balek "INPUT_TIDAK_VALID"
    kampret
        njir nominal <= batas
            balek "DALAM_BATAS"
        kampret
            balek "PERLU_PERSETUJUAN"
        selesai njir
    selesai njir
selesai fungsi

# Fixed acceptance cases: zero, exact boundary, over boundary, invalid amount,
# and invalid limit. CORE CI compares stdout byte-for-byte.
hedeh status_anggaran(0, 1000000)
hedeh status_anggaran(1000000, 1000000)
hedeh status_anggaran(1000001, 1000000)
hedeh status_anggaran(-1, 1000000)
hedeh status_anggaran(250000, -1)

selesai jancuk
