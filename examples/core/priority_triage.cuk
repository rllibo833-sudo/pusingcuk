# Deterministic task triage for local/AI-assisted operations.
# Inputs are bounded integer scales: urgency and impact, each 1..5.
# Pure policy only: no network, filesystem, environment, time, or model input.

jancuk

fungsi prioritas_tugas(urgensi, dampak)
    njir urgensi < 1 atau urgensi > 5 atau dampak < 1 atau dampak > 5
        balek "INPUT_TIDAK_VALID"
    kampret
        njir urgensi >= 4 dan dampak >= 4
            balek "P1_SEGERA"
        kampret
            njir dampak >= 4
                balek "P2_DAMPAK_TINGGI"
            kampret
                njir urgensi >= 4
                    balek "P3_MENDESAK"
                kampret
                    balek "P4_RUTIN"
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

tanya urgensi_teks = ""
tanya dampak_teks = ""
lah urgensi = bilangan(urgensi_teks)
lah dampak = bilangan(dampak_teks)
hedeh prioritas_tugas(urgensi, dampak)

selesai jancuk
