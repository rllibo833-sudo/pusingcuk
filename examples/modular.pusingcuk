inthiseco
  lah lib = angkut "utils.pusingcuk"
  coba
    spill lib.sapa("Budi")
    lah hilang = bongkar "gaada.txt"
    njir hilang == salah
      spill "berkas tidak ada"
    selesai njir
  ketangkep eror
    spill eror
  akhirnya
    spill "selesai"
  gitu coba
  spill jam()
  spill tanggal()
gitu inthiseco
