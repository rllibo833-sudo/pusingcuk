# Contoh native: rekap anggaran tanpa fungsi atau Python.
# Jalankan: pusingcuk-native examples/native/rekap_anggaran.pusingcuk

inthiseco
lah pendapatan = 2500000
lah pengeluaran = {"pangan": 750000, "transport": 250000, "listrik": 200000}
lah total = hitung_total(pengeluaran)

jir "REKAP ANGGARAN BULANAN"
jir "Pendapatan:"
jir pendapatan
jir "Rincian pengeluaran:"
untuk kategori dalam pengeluaran
    jir kategori
    jir pengeluaran[kategori]
gitu untuk

jir "Total pengeluaran:"
jir total
jir "Sisa anggaran:"
jir pendapatan - total

njir pendapatan - total >= 0
    jir "Status: anggaran aman"
adooh
    jir "Status: defisit"
gitu njir

fungsi hitung_total(data)
    lah jumlah = 0
    untuk kategori dalam data
        jumlah = jumlah + data[kategori]
    gitu untuk
    balek jumlah
gitu fungsi
gitu inthiseco
