# Lexer source nyata untuk subset bahasa .cuk.
# Dukungan: identifier ASCII, integer, string sederhana, operator,
# tanda baca, komentar #, newline, dan EOF.
# Dukungan string: escape newline/tab/CR, kutip, dan backslash; runtime native dan lexer .cuk harus sepakat pada escape ini. Angka pecahan/eksponen belum didukung.
jancuk

fungsi huruf(c)
    balek (c >= "a" dan c <= "z") atau (c >= "A" dan c <= "Z") atau c == "_"
selesai fungsi

fungsi digit(c)
    balek c >= "0" dan c <= "9"
selesai fungsi

fungsi bagian_nama(c)
    balek huruf(c) atau digit(c)
selesai fungsi

fungsi operator(c)
    balek c == "+" atau c == "-" atau c == "*" atau c == "/" atau c == "%" atau c == "=" atau c == "<" atau c == ">" atau c == "!"
selesai fungsi

fungsi tanda(c)
    balek c == "(" atau c == ")" atau c == "[" atau c == "]" atau c == "{" atau c == "}" atau c == "," atau c == ":" atau c == "."
selesai fungsi

fungsi pindai(source)
    lah tokens = []
    lah i = 0
    lah n = panjang(source)
    lah c = ""
    lah kutip = ""
    lah nilai = ""
    lah tertutup = salah
    lah jenis_angka = "INTEGER"

    mumet i < n
        c = source[i]

        njir c == " " atau c == "\t" atau c == "\r"
            i = i + 1
        kampret
            njir c == "\n"
                tokens = tokens + [{"jenis": "NEWLINE", "nilai": "NEWLINE"}]
                i = i + 1
            kampret
                njir c == "#"
                    mumet i < n dan source[i] != "\n"
                        i = i + 1
                    selesai mumet
                kampret
                    njir c == "\"" atau c == "'"
                        kutip = c
                        nilai = ""
                        tertutup = salah
                        i = i + 1
                        mumet i < n dan source[i] != "\n" dan bukan tertutup
                            njir source[i] == kutip
                                tertutup = benar
                                i = i + 1
                            kampret
                                njir source[i] == "\\" dan i + 1 < n
                                    njir source[i + 1] == "n"
                                        nilai = nilai + "\n"
                                    kampret
                                        njir source[i + 1] == "t"
                                            nilai = nilai + "\t"
                                        kampret
                                            njir source[i + 1] == "r"
                                                nilai = nilai + "\r"
                                            kampret
                                                njir source[i + 1] == "\\" 
                                                    nilai = nilai + "\\"
                                                kampret
                                                    njir source[i + 1] == "\"" atau source[i + 1] == "'"
                                                        nilai = nilai + source[i + 1]
                                                    kampret
                                                        nilai = nilai + source[i] + source[i + 1]
                                                    selesai njir
                                                selesai njir
                                            selesai njir
                                        selesai njir
                                    selesai njir
                                    i = i + 2
                                kampret
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai njir
                            selesai njir
                        selesai mumet
                        njir tertutup
                            tokens = tokens + [{"jenis": "STRING", "nilai": nilai}]
                        kampret
                            tokens = tokens + [{"jenis": "STRING_ERROR", "nilai": "STRING_BELUM_DITUTUP"}]
                        selesai njir
                    kampret
                        njir digit(c)
                            nilai = ""
                            mumet i < n dan digit(source[i])
                                nilai = nilai + source[i]
                                i = i + 1
                            selesai mumet
                            jenis_angka = "INTEGER"
                            njir i + 1 < n dan source[i] == "." dan digit(source[i + 1])
                                jenis_angka = "FLOAT"
                                nilai = nilai + "."
                                i = i + 1
                                mumet i < n dan digit(source[i])
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai mumet
                            selesai njir
                            tokens = tokens + [{"jenis": jenis_angka, "nilai": nilai}]
                        kampret
                            njir huruf(c)
                                nilai = ""
                                mumet i < n dan bagian_nama(source[i])
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai mumet
                                tokens = tokens + [{"jenis": "IDENT", "nilai": nilai}]
                            kampret
                                njir operator(c)
                                    nilai = c
                                    i = i + 1
                                    njir i < n dan ((c == "=" dan source[i] == "=") atau (c == "!" dan source[i] == "=") atau (c == "<" dan source[i] == "=") atau (c == ">" dan source[i] == "=") atau (c == "/" dan source[i] == "/"))
                                        nilai = nilai + source[i]
                                        i = i + 1
                                    selesai njir
                                    tokens = tokens + [{"jenis": "OP", "nilai": nilai}]
                                kampret
                                    njir tanda(c)
                                        tokens = tokens + [{"jenis": "PUNCT", "nilai": c}]
                                        i = i + 1
                                    kampret
                                        tokens = tokens + [{"jenis": "UNKNOWN", "nilai": c}]
                                        i = i + 1
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai mumet

    balek tokens + [{"jenis": "EOF", "nilai": "EOF"}]
selesai fungsi

fungsi render_tokens(tokens)
    untuk token dalam tokens
        hedeh token["jenis"] + ":" + token["nilai"]
    selesai untuk
selesai fungsi

# Parser recursive-descent dan evaluator AST untuk ekspresi aritmetika.
# Grammar: expr := term (("+" | "-") term)*
# term := primary (("*" | "/" | "%") primary)*
# primary := INTEGER | "-" primary | "(" expr ")"
fungsi node_gagal(index)
    balek {"status": "PARSE_ERROR", "index": index}
selesai fungsi

fungsi parse_call_arguments(tokens, nama, open_index)
    njir open_index >= panjang(tokens) atau tokens[open_index]["jenis"] != "PUNCT" atau tokens[open_index]["nilai"] != "("
        balek node_gagal(open_index)
    selesai njir
    lah args = []
    lah i = open_index + 1
    lah hasil_arg = {}
    njir i < panjang(tokens) dan tokens[i]["jenis"] == "PUNCT" dan tokens[i]["nilai"] == ")"
        balek {"status": "OK", "node": {"jenis": "CALL", "nama": nama, "args": args}, "index": i + 1}
    selesai njir
    mumet i < panjang(tokens) dan bukan (tokens[i]["jenis"] == "PUNCT" dan tokens[i]["nilai"] == ")")
        hasil_arg = parse_or(tokens, i)
        njir hasil_arg["status"] != "OK"
            balek hasil_arg
        selesai njir
        args = args + [hasil_arg["node"]]
        i = hasil_arg["index"]
        njir i < panjang(tokens) dan tokens[i]["jenis"] == "PUNCT" dan tokens[i]["nilai"] == ","
            i = i + 1
            njir i < panjang(tokens) dan tokens[i]["jenis"] == "PUNCT" dan tokens[i]["nilai"] == ")"
                balek node_gagal(i)
            selesai njir
        kampret
            njir i >= panjang(tokens) atau tokens[i]["jenis"] != "PUNCT" atau tokens[i]["nilai"] != ")"
                balek node_gagal(i)
            selesai njir
        selesai njir
    selesai mumet
    njir i < panjang(tokens) dan tokens[i]["jenis"] == "PUNCT" dan tokens[i]["nilai"] == ")"
        balek {"status": "OK", "node": {"jenis": "CALL", "nama": nama, "args": args}, "index": i + 1}
    kampret
        balek node_gagal(i)
    selesai njir
selesai fungsi

fungsi parse_line_expression(line_tokens, start)
    lah expression_tokens = []
    lah i = start
    mumet i < panjang(line_tokens)
        expression_tokens = expression_tokens + [line_tokens[i]]
        i = i + 1
    selesai mumet
    expression_tokens = expression_tokens + [{"jenis": "EOF", "nilai": "EOF"}]
    balek parse_source(expression_tokens)
selesai fungsi

fungsi tambahkan_statement(contexts, depth, statement)
    lah current = contexts[depth]
    njir current["jenis"] == "PROGRAM"
        current["statements"] = current["statements"] + [statement]
    kampret
        njir current["jenis"] == "IF"
            njir current["aktif_else"]
                current["else_body"] = current["else_body"] + [statement]
            kampret
                current["then_body"] = current["then_body"] + [statement]
            selesai njir
        kampret
            current["body"] = current["body"] + [statement]
        selesai njir
    selesai njir
selesai fungsi

fungsi parse_primary(tokens, index)
    njir index >= panjang(tokens)
        balek node_gagal(index)
    kampret
        lah token = tokens[index]
        lah next = index + 1
        lah left = {}
        lah index_result = {}
        lah member = ""
        lah method_result = {}
        njir token["jenis"] == "INTEGER" atau token["jenis"] == "FLOAT" atau token["jenis"] == "STRING"
            lah literal_value = token["nilai"]
            njir token["jenis"] == "INTEGER"
                literal_value = bilangan(literal_value)
            kampret
                njir token["jenis"] == "FLOAT"
                    literal_value = desimal(literal_value)
                selesai njir
            selesai njir
            left = {"jenis": token["jenis"], "nilai": literal_value}
        kampret
            njir token["jenis"] == "IDENT"
                njir token["nilai"] == "benar" atau token["nilai"] == "salah"
                    left = {"jenis": "BOOLEAN", "nilai": token["nilai"] == "benar"}
                kampret
                    njir token["nilai"] == "bukan"
                        lah hasil_bukan = parse_primary(tokens, next)
                        njir hasil_bukan["status"] != "OK"
                            balek hasil_bukan
                        selesai njir
                        left = {"jenis": "UNARY", "operator": "bukan", "nilai": hasil_bukan["node"]}
                        next = hasil_bukan["index"]
                    kampret
                        njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "("
                            lah hasil_panggilan = parse_call_arguments(tokens, token["nilai"], next)
                            njir hasil_panggilan["status"] != "OK"
                                balek hasil_panggilan
                            selesai njir
                            left = hasil_panggilan["node"]
                            next = hasil_panggilan["index"]
                        kampret
                            left = {"jenis": "VARIABLE", "nama": token["nilai"]}
                        selesai njir
                    selesai njir
                selesai njir
            kampret
                njir token["jenis"] == "OP" dan token["nilai"] == "-"
                    lah hasil_negatif = parse_primary(tokens, next)
                    njir hasil_negatif["status"] != "OK"
                        balek hasil_negatif
                    selesai njir
                    left = {"jenis": "UNARY", "operator": "-", "nilai": hasil_negatif["node"]}
                    next = hasil_negatif["index"]
                kampret
                    njir token["jenis"] == "PUNCT" dan token["nilai"] == "("
                        lah hasil_dalam = parse_or(tokens, next)
                        njir hasil_dalam["status"] != "OK"
                            balek hasil_dalam
                        selesai njir
                        njir hasil_dalam["index"] >= panjang(tokens) atau tokens[hasil_dalam["index"]]["jenis"] != "PUNCT" atau tokens[hasil_dalam["index"]]["nilai"] != ")"
                            balek node_gagal(hasil_dalam["index"])
                        selesai njir
                        left = hasil_dalam["node"]
                        next = hasil_dalam["index"] + 1
                    kampret
                        njir token["jenis"] == "PUNCT" dan token["nilai"] == "["
                            lah items = []
                            lah item_result = {}
                            njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "]"
                                left = {"jenis": "LIST", "items": items}
                                next = next + 1
                            kampret
                                mumet next < panjang(tokens) dan bukan (tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "]")
                                    item_result = parse_or(tokens, next)
                                    njir item_result["status"] != "OK"
                                        balek item_result
                                    selesai njir
                                    items = items + [item_result["node"]]
                                    next = item_result["index"]
                                    njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == ","
                                        next = next + 1
                                        njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "]"
                                            balek node_gagal(next)
                                        selesai njir
                                    kampret
                                        njir next >= panjang(tokens) atau tokens[next]["jenis"] != "PUNCT" atau tokens[next]["nilai"] != "]"
                                            balek node_gagal(next)
                                        selesai njir
                                    selesai njir
                                selesai mumet
                                njir next >= panjang(tokens) atau tokens[next]["jenis"] != "PUNCT" atau tokens[next]["nilai"] != "]"
                                    balek node_gagal(next)
                                selesai njir
                                left = {"jenis": "LIST", "items": items}
                                next = next + 1
                            selesai njir
                        kampret
                            njir token["jenis"] == "PUNCT" dan token["nilai"] == "{"
                                lah pairs = []
                                lah key_result = {}
                                lah value_result = {}
                                njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "}"
                                    left = {"jenis": "DICT", "items": pairs}
                                    next = next + 1
                                kampret
                                    mumet next < panjang(tokens) dan bukan (tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "}")
                                        key_result = parse_or(tokens, next)
                                        njir key_result["status"] != "OK"
                                            balek key_result
                                        selesai njir
                                        next = key_result["index"]
                                        njir next >= panjang(tokens) atau tokens[next]["jenis"] != "PUNCT" atau tokens[next]["nilai"] != ":"
                                            balek node_gagal(next)
                                        selesai njir
                                        value_result = parse_or(tokens, next + 1)
                                        njir value_result["status"] != "OK"
                                            balek value_result
                                        selesai njir
                                        pairs = pairs + [[key_result["node"], value_result["node"]]]
                                        next = value_result["index"]
                                        njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == ","
                                            next = next + 1
                                            njir next < panjang(tokens) dan tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "}"
                                                balek node_gagal(next)
                                            selesai njir
                                        kampret
                                            njir next >= panjang(tokens) atau tokens[next]["jenis"] != "PUNCT" atau tokens[next]["nilai"] != "}"
                                                balek node_gagal(next)
                                            selesai njir
                                        selesai njir
                                    selesai mumet
                                    njir next >= panjang(tokens) atau tokens[next]["jenis"] != "PUNCT" atau tokens[next]["nilai"] != "}"
                                        balek node_gagal(next)
                                    selesai njir
                                    left = {"jenis": "DICT", "items": pairs}
                                    next = next + 1
                                selesai njir
                            kampret
                                balek node_gagal(index)
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir

        mumet next < panjang(tokens) dan ((tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "[") atau (tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "."))
            njir tokens[next]["jenis"] == "PUNCT" dan tokens[next]["nilai"] == "["
                index_result = parse_or(tokens, next + 1)
                njir index_result["status"] != "OK"
                    balek index_result
                selesai njir
                njir index_result["index"] >= panjang(tokens) atau tokens[index_result["index"]]["jenis"] != "PUNCT" atau tokens[index_result["index"]]["nilai"] != "]"
                    balek node_gagal(index_result["index"])
                selesai njir
                left = {"jenis": "INDEX", "koleksi": left, "index": index_result["node"]}
                next = index_result["index"] + 1
            kampret
                njir next + 1 >= panjang(tokens) atau tokens[next + 1]["jenis"] != "IDENT"
                    balek node_gagal(next)
                selesai njir
                member = tokens[next + 1]["nilai"]
                njir next + 2 < panjang(tokens) dan tokens[next + 2]["jenis"] == "PUNCT" dan tokens[next + 2]["nilai"] == "("
                    njir left["jenis"] != "VARIABLE"
                        balek node_gagal(next)
                    selesai njir
                    method_result = parse_call_arguments(tokens, left["nama"] + "." + member, next + 2)
                    njir method_result["status"] != "OK"
                        balek method_result
                    selesai njir
                    left = method_result["node"]
                    next = method_result["index"]
                kampret
                    left = {"jenis": "ATTRIBUTE", "object": left, "nama": member}
                    next = next + 2
                selesai njir
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": left, "index": next}
    selesai njir
selesai fungsi

fungsi parse_term(tokens, index)
    lah kiri = parse_primary(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        lah op = ""
        lah kanan = {}
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "*" atau tokens[lanjut]["nilai"] == "/" atau tokens[lanjut]["nilai"] == "//" atau tokens[lanjut]["nilai"] == "%")
            op = tokens[lanjut]["nilai"]
            kanan = parse_primary(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_expression(tokens, index)
    lah kiri = parse_term(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        lah op = ""
        lah kanan = {}
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "+" atau tokens[lanjut]["nilai"] == "-")
            op = tokens[lanjut]["nilai"]
            kanan = parse_term(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_comparison(tokens, index)
    lah kiri = parse_expression(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        lah op = ""
        lah kanan = {}
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "==" atau tokens[lanjut]["nilai"] == "!=" atau tokens[lanjut]["nilai"] == "<" atau tokens[lanjut]["nilai"] == "<=" atau tokens[lanjut]["nilai"] == ">" atau tokens[lanjut]["nilai"] == ">=")
            op = tokens[lanjut]["nilai"]
            kanan = parse_expression(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_and(tokens, index)
    lah kiri = parse_comparison(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        lah kanan = {}
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "IDENT" dan tokens[lanjut]["nilai"] == "dan"
            kanan = parse_comparison(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": "dan", "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_or(tokens, index)
    lah kiri = parse_and(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        lah kanan = {}
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "IDENT" dan tokens[lanjut]["nilai"] == "atau"
            kanan = parse_and(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": "atau", "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_source(tokens)
    lah hasil = parse_or(tokens, 0)
    njir hasil["status"] != "OK"
        balek hasil
    kampret
        njir hasil["index"] != panjang(tokens) - 1 atau tokens[hasil["index"]]["jenis"] != "EOF"
            balek node_gagal(hasil["index"])
        kampret
            balek {"status": "OK", "node": hasil["node"]}
        selesai njir
    selesai njir
selesai fungsi

# Parser program bertahap: deklarasi, assignment, dan output per baris.
# Grammar: program := (declaration | assignment | print_stmt | NEWLINE)* EOF
# declaration := "lah" IDENT "=" expr
# assignment := IDENT "=" expr; target harus sudah dideklarasikan saat runtime
# print_stmt := "hedeh" expr
fungsi parse_program_line(line_tokens)
    njir panjang(line_tokens) == 0
        balek {"status": "OK", "statement": salah}
    selesai njir
    njir line_tokens[0]["jenis"] != "IDENT"
        balek node_gagal(0)
    selesai njir
    lah start = 0
    lah statement_kind = ""
    lah statement_name = ""
    lah target = {}
    lah cursor = 0
    lah tokens_with_eof = line_tokens + [{"jenis": "EOF", "nilai": "EOF"}]
    lah parsed_index = {}
    lah parsed_value = {}
    njir line_tokens[0]["nilai"] == "lah"
        njir panjang(line_tokens) < 4 atau line_tokens[1]["jenis"] != "IDENT" atau line_tokens[2]["nilai"] != "="
            balek node_gagal(0)
        selesai njir
        statement_kind = "DECLARE"
        statement_name = line_tokens[1]["nilai"]
        start = 3
    kampret
        njir line_tokens[0]["nilai"] == "balek"
            statement_kind = "RETURN"
            start = 1
        kampret
            njir line_tokens[0]["nilai"] == "hedeh" atau line_tokens[0]["nilai"] == "bacot" atau line_tokens[0]["nilai"] == "bacrit" atau line_tokens[0]["nilai"] == "berak" atau line_tokens[0]["nilai"] == "berisik" atau line_tokens[0]["nilai"] == "cetak" atau line_tokens[0]["nilai"] == "crot" atau line_tokens[0]["nilai"] == "gas" atau line_tokens[0]["nilai"] == "gebber" atau line_tokens[0]["nilai"] == "gembor" atau line_tokens[0]["nilai"] == "jedor" atau line_tokens[0]["nilai"] == "jir" atau line_tokens[0]["nilai"] == "keluarin" atau line_tokens[0]["nilai"] == "koar" atau line_tokens[0]["nilai"] == "muncrat" atau line_tokens[0]["nilai"] == "ngegas" atau line_tokens[0]["nilai"] == "nyalak" atau line_tokens[0]["nilai"] == "omong" atau line_tokens[0]["nilai"] == "print" atau line_tokens[0]["nilai"] == "sembur" atau line_tokens[0]["nilai"] == "semprot" atau line_tokens[0]["nilai"] == "senggol" atau line_tokens[0]["nilai"] == "spill" atau line_tokens[0]["nilai"] == "suarakan" atau line_tokens[0]["nilai"] == "tampilkan" atau line_tokens[0]["nilai"] == "teriak"
                statement_kind = "PRINT"
                start = 1
            kampret
                njir panjang(line_tokens) >= 3 dan line_tokens[0]["jenis"] == "IDENT" dan line_tokens[1]["jenis"] == "OP" dan line_tokens[1]["nilai"] == "="
                    statement_kind = "ASSIGN"
                    statement_name = line_tokens[0]["nilai"]
                    start = 2
                kampret
                    njir line_tokens[0]["jenis"] == "IDENT"
                        target = {"jenis": "VARIABLE", "nama": line_tokens[0]["nilai"]}
                        cursor = 1
                        mumet cursor < panjang(line_tokens) dan line_tokens[cursor]["jenis"] == "PUNCT" dan line_tokens[cursor]["nilai"] == "["
                            parsed_index = parse_or(tokens_with_eof, cursor + 1)
                            njir parsed_index["status"] != "OK"
                                balek parsed_index
                            selesai njir
                            njir parsed_index["index"] >= panjang(tokens_with_eof) atau tokens_with_eof[parsed_index["index"]]["jenis"] != "PUNCT" atau tokens_with_eof[parsed_index["index"]]["nilai"] != "]"
                                balek node_gagal(parsed_index["index"])
                            selesai njir
                            target = {"jenis": "INDEX", "koleksi": target, "index": parsed_index["node"]}
                            cursor = parsed_index["index"] + 1
                        selesai mumet
                        njir cursor > 1 dan cursor + 1 < panjang(tokens_with_eof) dan tokens_with_eof[cursor]["jenis"] == "OP" dan tokens_with_eof[cursor]["nilai"] == "="
                            statement_kind = "INDEX_ASSIGN"
                            start = cursor + 1
                        kampret
                            njir panjang(line_tokens) > 1 dan ((line_tokens[1]["jenis"] == "PUNCT" dan line_tokens[1]["nilai"] == "(") atau (panjang(line_tokens) > 3 dan line_tokens[1]["jenis"] == "PUNCT" dan line_tokens[1]["nilai"] == "." dan line_tokens[3]["nilai"] == "("))
                                parsed_value = parse_line_expression(line_tokens, 0)
                                njir parsed_value["status"] != "OK" atau parsed_value["node"]["jenis"] != "CALL"
                                    balek node_gagal(0)
                                selesai njir
                                balek {"status": "OK", "statement": {"jenis": "EXPR", "nilai": parsed_value["node"]}}
                            kampret
                                balek node_gagal(0)
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
    njir start >= panjang(line_tokens)
        balek node_gagal(0)
    selesai njir
    lah value_result = parse_line_expression(line_tokens, start)
    njir value_result["status"] != "OK"
        balek value_result
    selesai njir
    njir statement_kind == "DECLARE"
        balek {"status": "OK", "statement": {"jenis": "DECLARE", "nama": statement_name, "nilai": value_result["node"]}}
    kampret
        njir statement_kind == "ASSIGN"
            balek {"status": "OK", "statement": {"jenis": "ASSIGN", "nama": statement_name, "nilai": value_result["node"]}}
        kampret
            njir statement_kind == "INDEX_ASSIGN"
                njir target["jenis"] != "INDEX"
                    balek node_gagal(0)
                selesai njir
                balek {"status": "OK", "statement": {"jenis": "INDEX_ASSIGN", "koleksi": target["koleksi"], "index": target["index"], "nilai": value_result["node"]}}
            kampret
                njir statement_kind == "RETURN"
                    balek {"status": "OK", "statement": {"jenis": "RETURN", "nilai": value_result["node"]}}
                kampret
                    balek {"status": "OK", "statement": {"jenis": "PRINT", "nilai": value_result["node"]}}
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi parse_program(tokens)
    lah program = {"jenis": "PROGRAM", "statements": []}
    lah contexts = [program]
    lah depth = 0
    lah line_tokens = []
    lah i = 0
    lah current = {}
    lah new_context = {}
    lah function_params = []
    lah param_index = 0
    lah result = {}
    lah close_name = ""
    mumet i < panjang(tokens)
        njir tokens[i]["jenis"] == "NEWLINE" atau tokens[i]["jenis"] == "EOF"
            njir panjang(line_tokens) > 0
                njir line_tokens[0]["nilai"] == "kampret" dan panjang(line_tokens) == 1
                    current = contexts[depth]
                    njir current["jenis"] != "IF" atau current["aktif_else"]
                        balek node_gagal(i)
                    selesai njir
                    current["aktif_else"] = benar
                kampret
                    njir panjang(line_tokens) == 2 dan line_tokens[0]["nilai"] == "selesai"
                        current = contexts[depth]
                        close_name = line_tokens[1]["nilai"]
                        njir close_name == "fungsi"
                            njir current["jenis"] != "FUNCTION" atau depth != 1
                                balek node_gagal(i)
                            selesai njir
                            depth = depth - 1
                            program["statements"] = program["statements"] + [current]
                        kampret
                            njir close_name == "njir"
                                njir current["jenis"] != "IF"
                                    balek node_gagal(i)
                                selesai njir
                                depth = depth - 1
                            kampret
                                njir close_name == "mumet"
                                    njir current["jenis"] != "WHILE"
                                        balek node_gagal(i)
                                    selesai njir
                                    depth = depth - 1
                                kampret
                                    njir close_name == "untuk"
                                        njir current["jenis"] != "FOR"
                                            balek node_gagal(i)
                                        selesai njir
                                        depth = depth - 1
                                    kampret
                                        balek node_gagal(i)
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    kampret
                        njir line_tokens[0]["nilai"] == "fungsi"
                            njir depth != 0 atau panjang(line_tokens) < 4 atau line_tokens[1]["jenis"] != "IDENT" atau line_tokens[2]["nilai"] != "("
                                balek node_gagal(i)
                            selesai njir
                            function_params = []
                            param_index = 3
                            mumet param_index < panjang(line_tokens) dan line_tokens[param_index]["nilai"] != ")"
                                njir line_tokens[param_index]["jenis"] == "IDENT"
                                    njir param_index == 3 atau line_tokens[param_index - 1]["nilai"] == ","
                                        function_params = function_params + [line_tokens[param_index]["nilai"]]
                                    kampret
                                        balek node_gagal(i)
                                    selesai njir
                                kampret
                                    njir line_tokens[param_index]["nilai"] != ","
                                        balek node_gagal(i)
                                    selesai njir
                                selesai njir
                                param_index = param_index + 1
                            selesai mumet
                            njir param_index >= panjang(line_tokens) atau line_tokens[param_index]["nilai"] != ")" atau param_index + 1 != panjang(line_tokens)
                                balek node_gagal(i)
                            selesai njir
                            new_context = {"jenis": "FUNCTION", "nama": line_tokens[1]["nilai"], "params": function_params, "body": []}
                            depth = depth + 1
                            njir panjang(contexts) > depth
                                contexts[depth] = new_context
                            kampret
                                contexts = contexts + [new_context]
                            selesai njir
                        kampret
                            njir line_tokens[0]["nilai"] == "njir" atau line_tokens[0]["nilai"] == "mumet" atau line_tokens[0]["nilai"] == "untuk"
                                current = contexts[depth]
                                njir line_tokens[0]["nilai"] == "njir"
                                    result = parse_line_expression(line_tokens, 1)
                                    njir result["status"] != "OK"
                                        balek result
                                    selesai njir
                                    new_context = {"jenis": "IF", "condition": result["node"], "then_body": [], "else_body": [], "aktif_else": salah}
                                kampret
                                    njir line_tokens[0]["nilai"] == "mumet"
                                        result = parse_line_expression(line_tokens, 1)
                                        njir result["status"] != "OK"
                                            balek result
                                        selesai njir
                                        new_context = {"jenis": "WHILE", "condition": result["node"], "body": []}
                                    kampret
                                        njir panjang(line_tokens) < 4 atau line_tokens[1]["jenis"] != "IDENT" atau line_tokens[2]["nilai"] != "dalam"
                                            balek node_gagal(i)
                                        selesai njir
                                        result = parse_line_expression(line_tokens, 3)
                                        njir result["status"] != "OK"
                                            balek result
                                        selesai njir
                                        new_context = {"jenis": "FOR", "nama": line_tokens[1]["nilai"], "iterable": result["node"], "body": []}
                                    selesai njir
                                selesai njir
                                tambahkan_statement(contexts, depth, new_context)
                                depth = depth + 1
                                njir panjang(contexts) > depth
                                    contexts[depth] = new_context
                                kampret
                                    contexts = contexts + [new_context]
                                selesai njir
                            kampret
                                result = parse_program_line(line_tokens)
                                njir result["status"] != "OK" atau result["statement"] == salah
                                    balek node_gagal(i)
                                selesai njir
                                tambahkan_statement(contexts, depth, result["statement"])
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
            line_tokens = []
            njir tokens[i]["jenis"] == "EOF"
                njir depth != 0
                    balek node_gagal(i)
                selesai njir
                balek {"status": "OK", "node": program}
            selesai njir
        kampret
            njir tokens[i]["jenis"] == "STRING_ERROR" atau tokens[i]["jenis"] == "UNKNOWN"
                balek node_gagal(i)
            kampret
                line_tokens = line_tokens + [tokens[i]]
            selesai njir
        selesai njir
        i = i + 1
    selesai mumet
    balek node_gagal(i)
selesai fungsi

fungsi evaluasi_panggilan(node, lingkungan)
    lah argumen = node["args"]
    njir node["nama"] == "panjang"
        njir panjang(argumen) != 1
            balek "RUNTIME_ERROR_ARITY:panjang"
        kampret
            balek panjang(evaluasi(argumen[0], lingkungan))
        selesai njir
    kampret
        njir node["nama"] == "teks"
            njir panjang(argumen) != 1
                balek "RUNTIME_ERROR_ARITY:teks"
            kampret
                balek teks(evaluasi(argumen[0], lingkungan))
            selesai njir
        kampret
            njir node["nama"] == "bilangan"
                njir panjang(argumen) != 1
                    balek "RUNTIME_ERROR_ARITY:bilangan"
                kampret
                    balek bilangan(evaluasi(argumen[0], lingkungan))
                selesai njir
            kampret
                njir node["nama"] == "desimal"
                    njir panjang(argumen) != 1
                        balek "RUNTIME_ERROR_ARITY:desimal"
                    kampret
                        balek desimal(evaluasi(argumen[0], lingkungan))
                    selesai njir
                kampret
                    balek "RUNTIME_ERROR_UNKNOWN_BUILTIN:" + node["nama"]
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi evaluasi_biner(node, lingkungan)
    lah kiri = evaluasi(node["kiri"], lingkungan)
    lah kanan = evaluasi(node["kanan"], lingkungan)
    njir node["operator"] == "+"
        balek kiri + kanan
    kampret
        njir node["operator"] == "-"
            balek kiri - kanan
        kampret
            njir node["operator"] == "*"
                balek kiri * kanan
            kampret
                njir node["operator"] == "/"
                    njir kanan == 0
                        balek "DIVISION_BY_ZERO"
                    kampret
                        balek kiri / kanan
                    selesai njir
                kampret
                    njir node["operator"] == "//"
                        njir kanan == 0
                            balek "DIVISION_BY_ZERO"
                        kampret
                            balek lantai(kiri / kanan)
                        selesai njir
                    kampret
                        njir node["operator"] == "%"
                            njir kanan == 0
                                balek "DIVISION_BY_ZERO"
                            kampret
                                balek kiri % kanan
                            selesai njir
                        kampret
                            njir node["operator"] == "=="
                                balek kiri == kanan
                            kampret
                                njir node["operator"] == "!="
                                    balek bukan (kiri == kanan)
                                kampret
                                    njir node["operator"] == "<"
                                        balek kiri < kanan
                                    kampret
                                        njir node["operator"] == "<="
                                            balek kiri <= kanan
                                        kampret
                                            njir node["operator"] == ">"
                                                balek kiri > kanan
                                            kampret
                                                njir node["operator"] == ">="
                                                    balek kiri >= kanan
                                                kampret
                                                    njir node["operator"] == "dan"
                                                        balek kiri dan kanan
                                                    kampret
                                                        njir node["operator"] == "atau"
                                                            balek kiri atau kanan
                                                        kampret
                                                            balek "RUNTIME_ERROR_UNKNOWN_OPERATOR:" + node["operator"]
                                                        selesai njir
                                                    selesai njir
                                                selesai njir
                                            selesai njir
                                        selesai njir
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi evaluasi(node, lingkungan)
    njir node["jenis"] == "INTEGER" atau node["jenis"] == "FLOAT" atau node["jenis"] == "BOOLEAN" atau node["jenis"] == "STRING"
        balek node["nilai"]
    kampret
        njir node["jenis"] == "VARIABLE"
            balek lingkungan[node["nama"]]
        kampret
            njir node["jenis"] == "UNARY"
                njir node["operator"] == "bukan"
                    balek bukan evaluasi(node["nilai"], lingkungan)
                kampret
                    balek 0 - evaluasi(node["nilai"], lingkungan)
                selesai njir
            kampret
                njir node["jenis"] == "CALL"
                    balek evaluasi_panggilan(node, lingkungan)
                kampret
                    balek evaluasi_biner(node, lingkungan)
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi jalankan_program(program)
    lah lingkungan = {}
    lah nama_variabel = []
    lah output = []
    lah statements = program["statements"]
    lah i = 0
    lah j = 0
    lah stmt = {}
    lah nilai = 0
    lah ketemu = salah
    mumet i < panjang(statements)
        stmt = statements[i]
        nilai = evaluasi(stmt["nilai"], lingkungan)
        njir stmt["jenis"] == "DECLARE"
            lingkungan[stmt["nama"]] = nilai
            nama_variabel = nama_variabel + [stmt["nama"]]
        kampret
            njir stmt["jenis"] == "ASSIGN"
                ketemu = salah
                j = 0
                mumet j < panjang(nama_variabel)
                    njir nama_variabel[j] == stmt["nama"]
                        ketemu = benar
                    selesai njir
                    j = j + 1
                selesai mumet
                njir bukan ketemu
                    balek {"status": "RUNTIME_ERROR_UNDECLARED_ASSIGNMENT", "nama": stmt["nama"], "output": output, "lingkungan": lingkungan}
                selesai njir
                lingkungan[stmt["nama"]] = nilai
            kampret
                output = output + [nilai]
            selesai njir
        selesai njir
        i = i + 1
    selesai mumet
    balek {"status": "OK", "output": output, "lingkungan": lingkungan}
selesai fungsi

fungsi ir_quote(value)
    lah result = "\""
    lah i = 0
    lah c = ""
    mumet i < panjang(value)
        c = value[i]
        njir c == "\\"
            result = result + "\\\\"
        kampret
            njir c == "\""
                result = result + "\\\""
            kampret
                njir c == "\n"
                    result = result + "\\n"
                kampret
                    njir c == "\r"
                        result = result + "\\r"
                    kampret
                        njir c == "\t"
                            result = result + "\\t"
                        kampret
                            result = result + c
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
        i = i + 1
    selesai mumet
    balek result + "\""
selesai fungsi

fungsi ir_expr(node, line)
    njir node["jenis"] == "INTEGER" atau node["jenis"] == "FLOAT" atau node["jenis"] == "BOOLEAN" atau node["jenis"] == "STRING"
        lah encoded_value = teks(node["nilai"])
        njir node["jenis"] == "STRING"
            encoded_value = ir_quote(node["nilai"])
        kampret
            njir node["jenis"] == "BOOLEAN"
                njir node["nilai"]
                    encoded_value = "true"
                kampret
                    encoded_value = "false"
                selesai njir
            selesai njir
        selesai njir
        balek "{\"kind\":\"Literal\",\"line\":" + teks(line) + ",\"fields\":{\"value\":" + encoded_value + "}}"
    kampret
        njir node["jenis"] == "VARIABLE"
            balek "{\"kind\":\"Variable\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(node["nama"]) + "}}"
        kampret
            njir node["jenis"] == "CALL"
                lah args_json = ""
                lah i = 0
                mumet i < panjang(node["args"])
                    njir i > 0
                        args_json = args_json + ","
                    selesai njir
                    args_json = args_json + ir_expr(node["args"][i], line)
                    i = i + 1
                selesai mumet
                balek "{\"kind\":\"Call\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(node["nama"]) + ",\"args\":[" + args_json + "]}}"
            kampret
                njir node["jenis"] == "LIST"
                    lah items_json = ""
                    lah i = 0
                    mumet i < panjang(node["items"])
                        njir i > 0
                            items_json = items_json + ","
                        selesai njir
                        items_json = items_json + ir_expr(node["items"][i], line)
                        i = i + 1
                    selesai mumet
                    balek "{\"kind\":\"List\",\"line\":" + teks(line) + ",\"fields\":{\"items\":[" + items_json + "]}}"
                kampret
                    njir node["jenis"] == "DICT"
                        lah pairs_json = ""
                        lah i = 0
                        mumet i < panjang(node["items"])
                            njir i > 0
                                pairs_json = pairs_json + ","
                            selesai njir
                            pairs_json = pairs_json + "[" + ir_expr(node["items"][i][0], line) + "," + ir_expr(node["items"][i][1], line) + "]"
                            i = i + 1
                        selesai mumet
                        balek "{\"kind\":\"Dict\",\"line\":" + teks(line) + ",\"fields\":{\"items\":[" + pairs_json + "]}}"
                    kampret
                        njir node["jenis"] == "INDEX"
                            balek "{\"kind\":\"Index\",\"line\":" + teks(line) + ",\"fields\":{\"collection\":" + ir_expr(node["koleksi"], line) + ",\"index\":" + ir_expr(node["index"], line) + "}}"
                        kampret
                            njir node["jenis"] == "ATTRIBUTE"
                                balek "{\"kind\":\"Attribute\",\"line\":" + teks(line) + ",\"fields\":{\"object\":" + ir_expr(node["object"], line) + ",\"name\":" + ir_quote(node["nama"]) + "}}"
                            kampret
                                njir node["jenis"] == "UNARY"
                                    balek "{\"kind\":\"Unary\",\"line\":" + teks(line) + ",\"fields\":{\"op\":" + ir_quote(node["operator"]) + ",\"value\":" + ir_expr(node["nilai"], line) + "}}"
                                kampret
                                    njir node["jenis"] == "BINARY"
                                        balek "{\"kind\":\"Binary\",\"line\":" + teks(line) + ",\"fields\":{\"left\":" + ir_expr(node["kiri"], line) + ",\"op\":" + ir_quote(node["operator"]) + ",\"right\":" + ir_expr(node["kanan"], line) + "}}"
                                    kampret
                                        balek "null"
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi ir_statement(stmt, line)
    njir stmt["jenis"] == "IF"
        lah condition_json = ir_expr(stmt["condition"], line)
        lah then_json = ""
        lah else_json = ""
        lah i = 0
        mumet i < panjang(stmt["then_body"])
            njir i > 0
                then_json = then_json + ","
            selesai njir
            then_json = then_json + ir_statement(stmt["then_body"][i], line + i + 1)
            i = i + 1
        selesai mumet
        i = 0
        mumet i < panjang(stmt["else_body"])
            njir i > 0
                else_json = else_json + ","
            selesai njir
            else_json = else_json + ir_statement(stmt["else_body"][i], line + i + 1)
            i = i + 1
        selesai mumet
        balek "{\"kind\":\"If\",\"line\":" + teks(line) + ",\"fields\":{\"condition\":" + condition_json + ",\"then_body\":[" + then_json + "],\"else_body\":[" + else_json + "]}}"
    kampret
        njir stmt["jenis"] == "FUNCTION"
            lah params_json = ""
            lah body_json = ""
            lah i = 0
            mumet i < panjang(stmt["params"])
                njir i > 0
                    params_json = params_json + ","
                selesai njir
                params_json = params_json + ir_quote(stmt["params"][i])
                i = i + 1
            selesai mumet
            i = 0
            mumet i < panjang(stmt["body"])
                njir i > 0
                    body_json = body_json + ","
                selesai njir
                body_json = body_json + ir_statement(stmt["body"][i], line + i + 1)
                i = i + 1
            selesai mumet
            balek "{\"kind\":\"Function\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(stmt["nama"]) + ",\"params\":[" + params_json + "],\"body\":[" + body_json + "]}}"
        kampret
            njir stmt["jenis"] == "WHILE"
                lah body_json = ""
                lah i = 0
                mumet i < panjang(stmt["body"])
                    njir i > 0
                        body_json = body_json + ","
                    selesai njir
                    body_json = body_json + ir_statement(stmt["body"][i], line + i + 1)
                    i = i + 1
                selesai mumet
                balek "{\"kind\":\"While\",\"line\":" + teks(line) + ",\"fields\":{\"condition\":" + ir_expr(stmt["condition"], line) + ",\"body\":[" + body_json + "]}}"
            kampret
                njir stmt["jenis"] == "FOR"
                    lah body_json = ""
                    lah i = 0
                    mumet i < panjang(stmt["body"])
                        njir i > 0
                            body_json = body_json + ","
                        selesai njir
                        body_json = body_json + ir_statement(stmt["body"][i], line + i + 1)
                        i = i + 1
                    selesai mumet
                    balek "{\"kind\":\"For\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(stmt["nama"]) + ",\"iterable\":" + ir_expr(stmt["iterable"], line) + ",\"body\":[" + body_json + "]}}"
                kampret
                    njir stmt["jenis"] == "RETURN"
                        balek "{\"kind\":\"Return\",\"line\":" + teks(line) + ",\"fields\":{\"value\":" + ir_expr(stmt["nilai"], line) + "}}"
                    kampret
                        njir stmt["jenis"] == "DECLARE"
                            balek "{\"kind\":\"Declare\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(stmt["nama"]) + ",\"value\":" + ir_expr(stmt["nilai"], line) + "}}"
                        kampret
                            njir stmt["jenis"] == "ASSIGN"
                                balek "{\"kind\":\"Assign\",\"line\":" + teks(line) + ",\"fields\":{\"name\":" + ir_quote(stmt["nama"]) + ",\"value\":" + ir_expr(stmt["nilai"], line) + "}}"
                            kampret
                                njir stmt["jenis"] == "INDEX_ASSIGN"
                                    balek "{\"kind\":\"IndexAssign\",\"line\":" + teks(line) + ",\"fields\":{\"collection\":" + ir_expr(stmt["koleksi"], line) + ",\"index\":" + ir_expr(stmt["index"], line) + ",\"value\":" + ir_expr(stmt["nilai"], line) + "}}"
                                kampret
                                    njir stmt["jenis"] == "EXPR"
                                        balek ir_expr(stmt["nilai"], line)
                                    kampret
                                        njir stmt["jenis"] == "PRINT"
                                            balek "{\"kind\":\"Print\",\"line\":" + teks(line) + ",\"fields\":{\"value\":" + ir_expr(stmt["nilai"], line) + "}}"
                                        kampret
                                            balek "null"
                                        selesai njir
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi ir_program(program)
    lah body = ""
    lah i = 0
    lah jumlah_emit = 0
    lah root_line = 1
    njir panjang(program["statements"]) > 0
        root_line = 2
    selesai njir
    mumet i < panjang(program["statements"])
        njir program["statements"][i]["jenis"] == "DECLARE" atau program["statements"][i]["jenis"] == "ASSIGN" atau program["statements"][i]["jenis"] == "INDEX_ASSIGN" atau program["statements"][i]["jenis"] == "PRINT" atau program["statements"][i]["jenis"] == "EXPR" atau program["statements"][i]["jenis"] == "FUNCTION" atau program["statements"][i]["jenis"] == "IF" atau program["statements"][i]["jenis"] == "WHILE" atau program["statements"][i]["jenis"] == "FOR"
            njir jumlah_emit > 0
                body = body + ","
            selesai njir
            body = body + ir_statement(program["statements"][i], i + 2)
            jumlah_emit = jumlah_emit + 1
        selesai njir
        i = i + 1
    selesai mumet
    balek "{\"kind\":\"Program\",\"line\":" + teks(root_line) + ",\"fields\":{\"body\":[" + body + "]}}"
selesai fungsi

fungsi ir_map_expr(node, path, line)
    lah result = ",{\"path\":\"" + path + "\",\"line\":" + teks(line) + "}"
    njir node["jenis"] == "CALL"
        lah i = 0
        mumet i < panjang(node["args"])
            result = result + ir_map_expr(node["args"][i], path + ".fields.args[" + teks(i) + "]", line)
            i = i + 1
        selesai mumet
    kampret
        njir node["jenis"] == "LIST"
            lah i = 0
            mumet i < panjang(node["items"])
                result = result + ir_map_expr(node["items"][i], path + ".fields.items[" + teks(i) + "]", line)
                i = i + 1
            selesai mumet
        kampret
            njir node["jenis"] == "DICT"
                lah i = 0
                mumet i < panjang(node["items"])
                    result = result + ir_map_expr(node["items"][i][0], path + ".fields.items[" + teks(i) + "][0]", line)
                    result = result + ir_map_expr(node["items"][i][1], path + ".fields.items[" + teks(i) + "][1]", line)
                    i = i + 1
                selesai mumet
            kampret
                njir node["jenis"] == "INDEX"
                    result = result + ir_map_expr(node["koleksi"], path + ".fields.collection", line)
                    result = result + ir_map_expr(node["index"], path + ".fields.index", line)
                kampret
                    njir node["jenis"] == "ATTRIBUTE"
                        result = result + ir_map_expr(node["object"], path + ".fields.object", line)
                    kampret
                        njir node["jenis"] == "UNARY"
                            result = result + ir_map_expr(node["nilai"], path + ".fields.value", line)
                        kampret
                            njir node["jenis"] == "BINARY"
                                result = result + ir_map_expr(node["kiri"], path + ".fields.left", line)
                                result = result + ir_map_expr(node["kanan"], path + ".fields.right", line)
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
    balek result
selesai fungsi

fungsi ir_map_statement(stmt, path, line)
    njir stmt["jenis"] == "EXPR"
        balek ir_map_expr(stmt["nilai"], path, line)
    selesai njir
    lah result = ",{\"path\":\"" + path + "\",\"line\":" + teks(line) + "}"
    njir stmt["jenis"] == "IF"
        result = result + ir_map_expr(stmt["condition"], path + ".fields.condition", line)
        lah i = 0
        mumet i < panjang(stmt["else_body"])
            result = result + ir_map_statement(stmt["else_body"][i], path + ".fields.else_body[" + teks(i) + "]", line + i + 1)
            i = i + 1
        selesai mumet
        i = 0
        mumet i < panjang(stmt["then_body"])
            result = result + ir_map_statement(stmt["then_body"][i], path + ".fields.then_body[" + teks(i) + "]", line + i + 1)
            i = i + 1
        selesai mumet
    kampret
        njir stmt["jenis"] == "FUNCTION"
            lah i = 0
            mumet i < panjang(stmt["body"])
                result = result + ir_map_statement(stmt["body"][i], path + ".fields.body[" + teks(i) + "]", line + i + 1)
                i = i + 1
            selesai mumet
        kampret
            njir stmt["jenis"] == "WHILE"
                lah i = 0
                mumet i < panjang(stmt["body"])
                    result = result + ir_map_statement(stmt["body"][i], path + ".fields.body[" + teks(i) + "]", line + i + 1)
                    i = i + 1
                selesai mumet
                result = result + ir_map_expr(stmt["condition"], path + ".fields.condition", line)
            kampret
                njir stmt["jenis"] == "FOR"
                    lah i = 0
                    mumet i < panjang(stmt["body"])
                        result = result + ir_map_statement(stmt["body"][i], path + ".fields.body[" + teks(i) + "]", line + i + 1)
                        i = i + 1
                    selesai mumet
                    result = result + ir_map_expr(stmt["iterable"], path + ".fields.iterable", line)
                kampret
                    njir stmt["jenis"] == "RETURN"
                        result = result + ir_map_expr(stmt["nilai"], path + ".fields.value", line)
                    kampret
                        njir stmt["jenis"] == "INDEX_ASSIGN"
                            result = result + ir_map_expr(stmt["koleksi"], path + ".fields.collection", line)
                            result = result + ir_map_expr(stmt["index"], path + ".fields.index", line)
                            result = result + ir_map_expr(stmt["nilai"], path + ".fields.value", line)
                        kampret
                            result = result + ir_map_expr(stmt["nilai"], path + ".fields.value", line)
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
    balek result
selesai fungsi

fungsi ir_source_map(program)
    lah result = "{\"path\":\"$\",\"line\":"
    lah root_line = 1
    lah i = 0
    njir panjang(program["statements"]) > 0
        root_line = 2
    selesai njir
    result = result + teks(root_line) + "}"
    lah map_index = 0
    mumet i < panjang(program["statements"])
        njir program["statements"][i]["jenis"] == "DECLARE" atau program["statements"][i]["jenis"] == "ASSIGN" atau program["statements"][i]["jenis"] == "INDEX_ASSIGN" atau program["statements"][i]["jenis"] == "PRINT" atau program["statements"][i]["jenis"] == "EXPR" atau program["statements"][i]["jenis"] == "FUNCTION" atau program["statements"][i]["jenis"] == "IF" atau program["statements"][i]["jenis"] == "WHILE" atau program["statements"][i]["jenis"] == "FOR"
            result = result + ir_map_statement(program["statements"][i], "$.fields.body[" + teks(map_index) + "]", i + 2)
            map_index = map_index + 1
        selesai njir
        i = i + 1
    selesai mumet
    balek "[" + result + "]"
selesai fungsi

fungsi ir_collect_features(node, flags)
    njir node["jenis"] == "PROGRAM"
        lah i = 0
        mumet i < panjang(node["statements"])
            ir_collect_features(node["statements"][i], flags)
            i = i + 1
        selesai mumet
    kampret
        njir node["jenis"] == "IF" atau node["jenis"] == "WHILE" atau node["jenis"] == "FOR"
            flags["control-flow"] = benar
            njir node["jenis"] == "IF"
                ir_collect_features(node["condition"], flags)
                lah i = 0
                mumet i < panjang(node["then_body"])
                    ir_collect_features(node["then_body"][i], flags)
                    i = i + 1
                selesai mumet
                i = 0
                mumet i < panjang(node["else_body"])
                    ir_collect_features(node["else_body"][i], flags)
                    i = i + 1
                selesai mumet
            kampret
                njir node["jenis"] == "WHILE"
                    ir_collect_features(node["condition"], flags)
                kampret
                    ir_collect_features(node["iterable"], flags)
                selesai njir
                lah i = 0
                mumet i < panjang(node["body"])
                    ir_collect_features(node["body"][i], flags)
                    i = i + 1
                selesai mumet
            selesai njir
        kampret
            njir node["jenis"] == "FUNCTION"
                flags["functions"] = benar
                lah i = 0
                mumet i < panjang(node["body"])
                    ir_collect_features(node["body"][i], flags)
                    i = i + 1
                selesai mumet
            kampret
                njir node["jenis"] == "RETURN"
                    flags["functions"] = benar
                    ir_collect_features(node["nilai"], flags)
                kampret
                    njir node["jenis"] == "DECLARE" atau node["jenis"] == "ASSIGN"
                        flags["variables"] = benar
                        ir_collect_features(node["nilai"], flags)
                    kampret
                        njir node["jenis"] == "INDEX_ASSIGN"
                            flags["indexing"] = benar
                            ir_collect_features(node["koleksi"], flags)
                            ir_collect_features(node["index"], flags)
                            ir_collect_features(node["nilai"], flags)
                        kampret
                            njir node["jenis"] == "PRINT"
                                flags["console-output"] = benar
                                ir_collect_features(node["nilai"], flags)
                            kampret
                                njir node["jenis"] == "EXPR"
                                    ir_collect_features(node["nilai"], flags)
                                kampret
                                    njir node["jenis"] == "BINARY" atau node["jenis"] == "UNARY"
                                        flags["operators"] = benar
                                        njir node["jenis"] == "UNARY"
                                            ir_collect_features(node["nilai"], flags)
                                        kampret
                                            ir_collect_features(node["kiri"], flags)
                                            ir_collect_features(node["kanan"], flags)
                                        selesai njir
                                    kampret
                                        njir node["jenis"] == "VARIABLE"
                                            flags["variables"] = benar
                                        kampret
                                            njir node["jenis"] == "CALL"
                                                flags["calls"] = benar
                                                lah i = 0
                                                mumet i < panjang(node["args"])
                                                    ir_collect_features(node["args"][i], flags)
                                                    i = i + 1
                                                selesai mumet
                                            kampret
                                                njir node["jenis"] == "LIST"
                                                    flags["lists"] = benar
                                                    lah i = 0
                                                    mumet i < panjang(node["items"])
                                                        ir_collect_features(node["items"][i], flags)
                                                        i = i + 1
                                                    selesai mumet
                                                kampret
                                                    njir node["jenis"] == "DICT"
                                                        flags["dictionaries"] = benar
                                                        lah i = 0
                                                        mumet i < panjang(node["items"])
                                                            ir_collect_features(node["items"][i][0], flags)
                                                            ir_collect_features(node["items"][i][1], flags)
                                                            i = i + 1
                                                        selesai mumet
                                                    kampret
                                                        njir node["jenis"] == "INDEX"
                                                            flags["indexing"] = benar
                                                            ir_collect_features(node["koleksi"], flags)
                                                            ir_collect_features(node["index"], flags)
                                                        kampret
                                                            njir node["jenis"] == "ATTRIBUTE"
                                                                flags["namespaced-access"] = benar
                                                                ir_collect_features(node["object"], flags)
                                                            selesai njir
                                                        selesai njir
                                                    selesai njir
                                                selesai njir
                                            selesai njir
                                        selesai njir
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi ir_features(program)
    lah flags = {"core": benar, "calls": salah, "console-output": salah, "control-flow": salah, "dictionaries": salah, "functions": salah, "indexing": salah, "lists": salah, "namespaced-access": salah, "operators": salah, "variables": salah}
    ir_collect_features(program, flags)
    lah result = "["
    njir flags["calls"]
        result = result + "\"calls\","
    selesai njir
    njir flags["console-output"]
        result = result + "\"console-output\","
    selesai njir
    njir flags["control-flow"]
        result = result + "\"control-flow\","
    selesai njir
    result = result + "\"core\""
    njir flags["dictionaries"]
        result = result + ",\"dictionaries\""
    selesai njir
    njir flags["functions"]
        result = result + ",\"functions\""
    selesai njir
    njir flags["indexing"]
        result = result + ",\"indexing\""
    selesai njir
    njir flags["lists"]
        result = result + ",\"lists\""
    selesai njir
    njir flags["namespaced-access"]
        result = result + ",\"namespaced-access\""
    selesai njir
    njir flags["operators"]
        result = result + ",\"operators\""
    selesai njir
    njir flags["variables"]
        result = result + ",\"variables\""
    selesai njir
    balek result + "]"
selesai fungsi

fungsi ir_document(program, source_name)
    balek "{\"format\":\"pusingcuk-ir\",\"ir_version\":1,\"language_version\":\"0.6-dev\",\"source_name\":" + ir_quote(source_name) + ",\"features\":" + ir_features(program) + ",\"source_map\":" + ir_source_map(program) + ",\"program\":" + ir_program(program) + "}"
selesai fungsi


