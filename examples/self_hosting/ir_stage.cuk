jancuk
lah raw = tanya ""
njir raw == ""
    hedeh "IR_STAGE_INVALID_JSON"
kampret
    lah doc = jadi_json(raw)
    njir doc == salah
        hedeh "IR_STAGE_INVALID_JSON"
    kampret
        njir doc["format"] != "pusingcuk-ir"
            hedeh "IR_STAGE_INVALID_ENVELOPE"
        kampret
            njir doc["ir_version"] != 1
                hedeh "IR_STAGE_INVALID_ENVELOPE"
            kampret
                njir doc["program"]["kind"] != "Program"
                    hedeh "IR_STAGE_INVALID_ENVELOPE"
                kampret
                    hedeh jadi_json(doc)
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai njir
selesai jancuk
