# Lexer source nyata untuk subset bahasa .cuk.
# Dukungan: identifier ASCII, integer, string sederhana, operator,
# tanda baca, komentar #, newline, dan EOF.
# Batasan: belum normalisasi alias keyword, angka pecahan/eksponen, atau escape decoding.
jancuk

fungsi huruf(c)
    balek (c >= "a" dan c <= "z") atau (c >= "A" dan c <= "Z") atau c == "_"
selesai fungsi

fungsi digit(c)
    balek c >= "0" dan c <= "9"
selesai fungsi

fungsi bagian_nama(c)
    balek huruf(c) atau digit(c)
selesai fungsi

fungsi operator(c)
    balek c == "+" atau c == "-" atau c == "*" atau c == "/" atau c == "%" atau c == "=" atau c == "<" atau c == ">" atau c == "!"
selesai fungsi

fungsi tanda(c)
    balek c == "(" atau c == ")" atau c == "[" atau c == "]" atau c == "{" atau c == "}" atau c == "," atau c == ":" atau c == "."
selesai fungsi

fungsi pindai(source)
    lah tokens = []
    lah i = 0
    lah n = panjang(source)
    lah c = ""
    lah kutip = ""
    lah nilai = ""
    lah tertutup = salah

    mumet i < n
        c = source[i]

        njir c == " " atau c == "\t" atau c == "\r"
            i = i + 1
        kampret
            njir c == "\n"
                tokens = tokens + [{"jenis": "NEWLINE", "nilai": "NEWLINE"}]
                i = i + 1
            kampret
                njir c == "#"
                    mumet i < n dan source[i] != "\n"
                        i = i + 1
                    selesai mumet
                kampret
                    njir c == "\"" atau c == "'"
                        kutip = c
                        nilai = ""
                        tertutup = salah
                        i = i + 1
                        mumet i < n dan source[i] != "\n" dan bukan tertutup
                            njir source[i] == kutip
                                tertutup = benar
                                i = i + 1
                            kampret
                                njir source[i] == "\\" dan i + 1 < n
                                    nilai = nilai + source[i] + source[i + 1]
                                    i = i + 2
                                kampret
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai njir
                            selesai njir
                        selesai mumet
                        njir tertutup
                            tokens = tokens + [{"jenis": "STRING", "nilai": nilai}]
                        kampret
                            tokens = tokens + [{"jenis": "STRING_ERROR", "nilai": "STRING_BELUM_DITUTUP"}]
                        selesai njir
                    kampret
                        njir digit(c)
                            nilai = ""
                            mumet i < n dan digit(source[i])
                                nilai = nilai + source[i]
                                i = i + 1
                            selesai mumet
                            tokens = tokens + [{"jenis": "INTEGER", "nilai": nilai}]
                        kampret
                            njir huruf(c)
                                nilai = ""
                                mumet i < n dan bagian_nama(source[i])
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai mumet
                                tokens = tokens + [{"jenis": "IDENT", "nilai": nilai}]
                            kampret
                                njir operator(c)
                                    nilai = c
                                    i = i + 1
                                    njir i < n dan ((c == "=" dan source[i] == "=") atau (c == "!" dan source[i] == "=") atau (c == "<" dan source[i] == "=") atau (c == ">" dan source[i] == "=") atau (c == "/" dan source[i] == "/"))
                                        nilai = nilai + source[i]
                                        i = i + 1
                                    selesai njir
                                    tokens = tokens + [{"jenis": "OP", "nilai": nilai}]
                                kampret
                                    njir tanda(c)
                                        tokens = tokens + [{"jenis": "PUNCT", "nilai": c}]
                                        i = i + 1
                                    kampret
                                        tokens = tokens + [{"jenis": "UNKNOWN", "nilai": c}]
                                        i = i + 1
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai mumet

    balek tokens + [{"jenis": "EOF", "nilai": "EOF"}]
selesai fungsi

fungsi render_tokens(tokens)
    untuk token dalam tokens
        hedeh token["jenis"] + ":" + token["nilai"]
    selesai untuk
selesai fungsi

# Parser recursive-descent dan evaluator AST untuk ekspresi aritmetika.
# Grammar: expr := term (("+" | "-") term)*
# term := primary (("*" | "/") primary)*
# primary := INTEGER | "(" expr ")"
fungsi node_gagal(index)
    balek {"status": "PARSE_ERROR", "index": index}
selesai fungsi

fungsi parse_primary(tokens, index)
    njir index >= panjang(tokens)
        balek node_gagal(index)
    kampret
        njir tokens[index]["jenis"] == "INTEGER"
            balek {"status": "OK", "node": {"jenis": "INTEGER", "nilai": bilangan(tokens[index]["nilai"])}, "index": index + 1}
        kampret
            njir tokens[index]["jenis"] == "PUNCT" dan tokens[index]["nilai"] == "("
                lah hasil_dalam = parse_expression(tokens, index + 1)
                njir hasil_dalam["status"] != "OK"
                    balek hasil_dalam
                kampret
                    njir hasil_dalam["index"] >= panjang(tokens) atau tokens[hasil_dalam["index"]]["jenis"] != "PUNCT" atau tokens[hasil_dalam["index"]]["nilai"] != ")"
                        balek node_gagal(hasil_dalam["index"])
                    kampret
                        balek {"status": "OK", "node": hasil_dalam["node"], "index": hasil_dalam["index"] + 1}
                    selesai njir
                selesai njir
            kampret
                balek node_gagal(index)
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi parse_term(tokens, index)
    lah kiri = parse_primary(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "*" atau tokens[lanjut]["nilai"] == "/")
            lah op = tokens[lanjut]["nilai"]
            lah kanan = parse_primary(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_expression(tokens, index)
    lah kiri = parse_term(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "+" atau tokens[lanjut]["nilai"] == "-")
            lah op = tokens[lanjut]["nilai"]
            lah kanan = parse_term(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_source(tokens)
    lah hasil = parse_expression(tokens, 0)
    njir hasil["status"] != "OK"
        balek hasil
    kampret
        njir hasil["index"] != panjang(tokens) - 1 atau tokens[hasil["index"]]["jenis"] != "EOF"
            balek node_gagal(hasil["index"])
        kampret
            balek {"status": "OK", "node": hasil["node"]}
        selesai njir
    selesai njir
selesai fungsi

fungsi evaluasi(node)
    njir node["jenis"] == "INTEGER"
        balek node["nilai"]
    kampret
        lah kiri = evaluasi(node["kiri"])
        lah kanan = evaluasi(node["kanan"])
        njir node["operator"] == "+"
            balek kiri + kanan
        kampret
            njir node["operator"] == "-"
                balek kiri - kanan
            kampret
                njir node["operator"] == "*"
                    balek kiri * kanan
                kampret
                    njir kanan == 0
                        balek "DIVISION_BY_ZERO"
                    kampret
                        balek kiri / kanan
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

lah contoh = "lah x = 12 + 3\\nhedeh x # komentar\\n"
render_tokens(pindai(contoh))

lah ast = parse_source(pindai("2 + 3 * 4"))
hedeh "PRECEDENCE_" + ast["status"]
njir ast["status"] == "OK"
    hedeh evaluasi(ast["node"])
selesai njir

lah ast_group = parse_source(pindai("(2 + 3) * 4"))
hedeh "PARENS_" + ast_group["status"]
njir ast_group["status"] == "OK"
    hedeh evaluasi(ast_group["node"])
selesai njir

lah ast_invalid = parse_source(pindai("7 % 35"))
hedeh "INVALID_" + ast_invalid["status"]
selesai jancuk
