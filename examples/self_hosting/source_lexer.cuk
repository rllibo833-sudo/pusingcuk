# Lexer source nyata untuk subset bahasa .cuk.
# Dukungan: identifier ASCII, integer, string sederhana, operator,
# tanda baca, komentar #, newline, dan EOF.
# Batasan: belum normalisasi alias keyword, angka pecahan/eksponen, atau escape decoding.
jancuk

fungsi huruf(c)
    balek (c >= "a" dan c <= "z") atau (c >= "A" dan c <= "Z") atau c == "_"
selesai fungsi

fungsi digit(c)
    balek c >= "0" dan c <= "9"
selesai fungsi

fungsi bagian_nama(c)
    balek huruf(c) atau digit(c)
selesai fungsi

fungsi operator(c)
    balek c == "+" atau c == "-" atau c == "*" atau c == "/" atau c == "%" atau c == "=" atau c == "<" atau c == ">" atau c == "!"
selesai fungsi

fungsi tanda(c)
    balek c == "(" atau c == ")" atau c == "[" atau c == "]" atau c == "{" atau c == "}" atau c == "," atau c == ":" atau c == "."
selesai fungsi

fungsi pindai(source)
    lah tokens = []
    lah i = 0
    lah n = panjang(source)
    lah c = ""
    lah kutip = ""
    lah nilai = ""
    lah tertutup = salah

    mumet i < n
        c = source[i]

        njir c == " " atau c == "\t" atau c == "\r"
            i = i + 1
        kampret
            njir c == "\n"
                tokens = tokens + [{"jenis": "NEWLINE", "nilai": "NEWLINE"}]
                i = i + 1
            kampret
                njir c == "#"
                    mumet i < n dan source[i] != "\n"
                        i = i + 1
                    selesai mumet
                kampret
                    njir c == "\"" atau c == "'"
                        kutip = c
                        nilai = ""
                        tertutup = salah
                        i = i + 1
                        mumet i < n dan source[i] != "\n" dan bukan tertutup
                            njir source[i] == kutip
                                tertutup = benar
                                i = i + 1
                            kampret
                                njir source[i] == "\\" dan i + 1 < n
                                    njir source[i + 1] == "n"
                                        nilai = nilai + "\n"
                                    kampret
                                        njir source[i + 1] == "t"
                                            nilai = nilai + "\t"
                                        kampret
                                            njir source[i + 1] == "r"
                                                nilai = nilai + "\r"
                                            kampret
                                                njir source[i + 1] == "\\" 
                                                    nilai = nilai + "\\"
                                                kampret
                                                    njir source[i + 1] == "\"" atau source[i + 1] == "'"
                                                        nilai = nilai + source[i + 1]
                                                    kampret
                                                        nilai = nilai + source[i] + source[i + 1]
                                                    selesai njir
                                                selesai njir
                                            selesai njir
                                        selesai njir
                                    selesai njir
                                    i = i + 2
                                kampret
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai njir
                            selesai njir
                        selesai mumet
                        njir tertutup
                            tokens = tokens + [{"jenis": "STRING", "nilai": nilai}]
                        kampret
                            tokens = tokens + [{"jenis": "STRING_ERROR", "nilai": "STRING_BELUM_DITUTUP"}]
                        selesai njir
                    kampret
                        njir digit(c)
                            nilai = ""
                            mumet i < n dan digit(source[i])
                                nilai = nilai + source[i]
                                i = i + 1
                            selesai mumet
                            tokens = tokens + [{"jenis": "INTEGER", "nilai": nilai}]
                        kampret
                            njir huruf(c)
                                nilai = ""
                                mumet i < n dan bagian_nama(source[i])
                                    nilai = nilai + source[i]
                                    i = i + 1
                                selesai mumet
                                tokens = tokens + [{"jenis": "IDENT", "nilai": nilai}]
                            kampret
                                njir operator(c)
                                    nilai = c
                                    i = i + 1
                                    njir i < n dan ((c == "=" dan source[i] == "=") atau (c == "!" dan source[i] == "=") atau (c == "<" dan source[i] == "=") atau (c == ">" dan source[i] == "=") atau (c == "/" dan source[i] == "/"))
                                        nilai = nilai + source[i]
                                        i = i + 1
                                    selesai njir
                                    tokens = tokens + [{"jenis": "OP", "nilai": nilai}]
                                kampret
                                    njir tanda(c)
                                        tokens = tokens + [{"jenis": "PUNCT", "nilai": c}]
                                        i = i + 1
                                    kampret
                                        tokens = tokens + [{"jenis": "UNKNOWN", "nilai": c}]
                                        i = i + 1
                                    selesai njir
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai mumet

    balek tokens + [{"jenis": "EOF", "nilai": "EOF"}]
selesai fungsi

fungsi render_tokens(tokens)
    untuk token dalam tokens
        hedeh token["jenis"] + ":" + token["nilai"]
    selesai untuk
selesai fungsi

# Parser recursive-descent dan evaluator AST untuk ekspresi aritmetika.
# Grammar: expr := term (("+" | "-") term)*
# term := primary (("*" | "/" | "%") primary)*
# primary := INTEGER | "-" primary | "(" expr ")"
fungsi node_gagal(index)
    balek {"status": "PARSE_ERROR", "index": index}
selesai fungsi

fungsi parse_primary(tokens, index)
    njir index >= panjang(tokens)
        balek node_gagal(index)
    kampret
        njir tokens[index]["jenis"] == "INTEGER"
            balek {"status": "OK", "node": {"jenis": "INTEGER", "nilai": bilangan(tokens[index]["nilai"])}, "index": index + 1}
        kampret
            njir tokens[index]["jenis"] == "STRING"
                balek {"status": "OK", "node": {"jenis": "STRING", "nilai": tokens[index]["nilai"]}, "index": index + 1}
            kampret
                njir tokens[index]["jenis"] == "IDENT"
                balek {"status": "OK", "node": {"jenis": "VARIABLE", "nama": tokens[index]["nilai"]}, "index": index + 1}
            kampret
                njir tokens[index]["jenis"] == "OP" dan tokens[index]["nilai"] == "-"
                    lah hasil_negatif = parse_primary(tokens, index + 1)
                    njir hasil_negatif["status"] != "OK"
                        balek hasil_negatif
                    kampret
                        balek {"status": "OK", "node": {"jenis": "UNARY", "operator": "-", "nilai": hasil_negatif["node"]}, "index": hasil_negatif["index"]}
                    selesai njir
                kampret
                    njir tokens[index]["jenis"] == "PUNCT" dan tokens[index]["nilai"] == "("
                        lah hasil_dalam = parse_expression(tokens, index + 1)
                        njir hasil_dalam["status"] != "OK"
                            balek hasil_dalam
                        kampret
                            njir hasil_dalam["index"] >= panjang(tokens) atau tokens[hasil_dalam["index"]]["jenis"] != "PUNCT" atau tokens[hasil_dalam["index"]]["nilai"] != ")"
                                balek node_gagal(hasil_dalam["index"])
                            kampret
                                balek {"status": "OK", "node": hasil_dalam["node"], "index": hasil_dalam["index"] + 1}
                            selesai njir
                        selesai njir
                    kampret
                        balek node_gagal(index)
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi parse_term(tokens, index)
    lah kiri = parse_primary(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "*" atau tokens[lanjut]["nilai"] == "/" atau tokens[lanjut]["nilai"] == "%")
            lah op = tokens[lanjut]["nilai"]
            lah kanan = parse_primary(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_expression(tokens, index)
    lah kiri = parse_term(tokens, index)
    njir kiri["status"] != "OK"
        balek kiri
    kampret
        lah lanjut = kiri["index"]
        lah node = kiri["node"]
        mumet lanjut < panjang(tokens) dan tokens[lanjut]["jenis"] == "OP" dan (tokens[lanjut]["nilai"] == "+" atau tokens[lanjut]["nilai"] == "-")
            lah op = tokens[lanjut]["nilai"]
            lah kanan = parse_term(tokens, lanjut + 1)
            njir kanan["status"] != "OK"
                balek kanan
            kampret
                node = {"jenis": "BINARY", "operator": op, "kiri": node, "kanan": kanan["node"]}
                lanjut = kanan["index"]
            selesai njir
        selesai mumet
        balek {"status": "OK", "node": node, "index": lanjut}
    selesai njir
selesai fungsi

fungsi parse_source(tokens)
    lah hasil = parse_expression(tokens, 0)
    njir hasil["status"] != "OK"
        balek hasil
    kampret
        njir hasil["index"] != panjang(tokens) - 1 atau tokens[hasil["index"]]["jenis"] != "EOF"
            balek node_gagal(hasil["index"])
        kampret
            balek {"status": "OK", "node": hasil["node"]}
        selesai njir
    selesai njir
selesai fungsi

# Parser program bertahap: deklarasi, assignment, dan output per baris.
# Grammar: program := (declaration | assignment | print_stmt | NEWLINE)* EOF
# declaration := "lah" IDENT "=" expr
# assignment := IDENT "=" expr; target harus sudah dideklarasikan saat runtime
# print_stmt := "hedeh" expr
fungsi parse_program_line(line_tokens)
    njir panjang(line_tokens) == 0
        balek {"status": "OK", "statement": salah}
    kampret
        lah mulai = 0
        lah jenis_stmt = ""
        lah nama_stmt = ""
        njir line_tokens[0]["jenis"] != "IDENT"
            balek node_gagal(0)
        kampret
            njir line_tokens[0]["nilai"] == "lah"
                njir panjang(line_tokens) < 4 atau line_tokens[1]["jenis"] != "IDENT" atau line_tokens[2]["jenis"] != "OP" atau line_tokens[2]["nilai"] != "="
                    balek node_gagal(0)
                kampret
                    jenis_stmt = "DECLARE"
                    nama_stmt = line_tokens[1]["nilai"]
                    mulai = 3
                selesai njir
            kampret
                njir line_tokens[0]["nilai"] == "hedeh" atau line_tokens[0]["nilai"] == "bacot" atau line_tokens[0]["nilai"] == "bacrit" atau line_tokens[0]["nilai"] == "berak" atau line_tokens[0]["nilai"] == "berisik" atau line_tokens[0]["nilai"] == "cetak" atau line_tokens[0]["nilai"] == "crot" atau line_tokens[0]["nilai"] == "gas" atau line_tokens[0]["nilai"] == "gebber" atau line_tokens[0]["nilai"] == "gembor" atau line_tokens[0]["nilai"] == "jedor" atau line_tokens[0]["nilai"] == "jir" atau line_tokens[0]["nilai"] == "keluarin" atau line_tokens[0]["nilai"] == "koar" atau line_tokens[0]["nilai"] == "muncrat" atau line_tokens[0]["nilai"] == "ngegas" atau line_tokens[0]["nilai"] == "nyalak" atau line_tokens[0]["nilai"] == "omong" atau line_tokens[0]["nilai"] == "print" atau line_tokens[0]["nilai"] == "sembur" atau line_tokens[0]["nilai"] == "semprot" atau line_tokens[0]["nilai"] == "senggol" atau line_tokens[0]["nilai"] == "spill" atau line_tokens[0]["nilai"] == "suarakan" atau line_tokens[0]["nilai"] == "tampilkan" atau line_tokens[0]["nilai"] == "teriak"
                    jenis_stmt = "PRINT"
                    mulai = 1
                kampret
                    njir panjang(line_tokens) >= 3 dan line_tokens[0]["jenis"] == "IDENT" dan line_tokens[1]["jenis"] == "OP" dan line_tokens[1]["nilai"] == "="
                        jenis_stmt = "ASSIGN"
                        nama_stmt = line_tokens[0]["nilai"]
                        mulai = 2
                    kampret
                        balek node_gagal(0)
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
        lah expr_tokens = []
        lah i = mulai
        mumet i < panjang(line_tokens)
            expr_tokens = expr_tokens + [line_tokens[i]]
            i = i + 1
        selesai mumet
        expr_tokens = expr_tokens + [{"jenis": "EOF", "nilai": "EOF"}]
        lah hasil_expr = parse_source(expr_tokens)
        njir hasil_expr["status"] != "OK"
            balek hasil_expr
        kampret
            njir jenis_stmt == "DECLARE"
                balek {"status": "OK", "statement": {"jenis": "DECLARE", "nama": nama_stmt, "nilai": hasil_expr["node"]}}
            kampret
                njir jenis_stmt == "ASSIGN"
                    balek {"status": "OK", "statement": {"jenis": "ASSIGN", "nama": nama_stmt, "nilai": hasil_expr["node"]}}
                kampret
                    balek {"status": "OK", "statement": {"jenis": "PRINT", "nilai": hasil_expr["node"]}}
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi parse_program(tokens)
    lah statements = []
    lah line_tokens = []
    lah i = 0
    lah hasil_line = {}
    mumet i < panjang(tokens)
        njir tokens[i]["jenis"] == "NEWLINE" atau tokens[i]["jenis"] == "EOF"
            hasil_line = parse_program_line(line_tokens)
            njir hasil_line["status"] != "OK"
                balek hasil_line
            kampret
                njir hasil_line["statement"] != salah
                    statements = statements + [hasil_line["statement"]]
                selesai njir
            selesai njir
            line_tokens = []
            njir tokens[i]["jenis"] == "EOF"
                balek {"status": "OK", "node": {"jenis": "PROGRAM", "statements": statements}}
            selesai njir
        kampret
            njir tokens[i]["jenis"] == "STRING_ERROR" atau tokens[i]["jenis"] == "UNKNOWN"
                balek node_gagal(i)
            kampret
                line_tokens = line_tokens + [tokens[i]]
            selesai njir
        selesai njir
        i = i + 1
    selesai mumet
    balek node_gagal(i)
selesai fungsi

fungsi evaluasi(node, lingkungan)
    njir node["jenis"] == "INTEGER"
        balek node["nilai"]
    kampret
        njir node["jenis"] == "VARIABLE"
            balek lingkungan[node["nama"]]
        kampret
            njir node["jenis"] == "UNARY"
                balek 0 - evaluasi(node["nilai"], lingkungan)
            kampret
                lah kiri = evaluasi(node["kiri"], lingkungan)
                lah kanan = evaluasi(node["kanan"], lingkungan)
                njir node["operator"] == "+"
                    balek kiri + kanan
                kampret
                    njir node["operator"] == "-"
                        balek kiri - kanan
                    kampret
                        njir node["operator"] == "*"
                            balek kiri * kanan
                        kampret
                            njir node["operator"] == "%"
                                njir kanan == 0
                                    balek "DIVISION_BY_ZERO"
                                kampret
                                    balek kiri % kanan
                                selesai njir
                            kampret
                                njir kanan == 0
                                    balek "DIVISION_BY_ZERO"
                                kampret
                                    balek kiri / kanan
                                selesai njir
                            selesai njir
                        selesai njir
                    selesai njir
                selesai njir
            selesai njir
        selesai njir
    selesai njir
selesai fungsi

fungsi jalankan_program(program)
    lah lingkungan = {}
    lah nama_variabel = []
    lah output = []
    lah statements = program["statements"]
    lah i = 0
    lah j = 0
    lah stmt = {}
    lah nilai = 0
    lah ketemu = salah
    mumet i < panjang(statements)
        stmt = statements[i]
        nilai = evaluasi(stmt["nilai"], lingkungan)
        njir stmt["jenis"] == "DECLARE"
            lingkungan[stmt["nama"]] = nilai
            nama_variabel = nama_variabel + [stmt["nama"]]
        kampret
            njir stmt["jenis"] == "ASSIGN"
                ketemu = salah
                j = 0
                mumet j < panjang(nama_variabel)
                    njir nama_variabel[j] == stmt["nama"]
                        ketemu = benar
                    selesai njir
                    j = j + 1
                selesai mumet
                njir bukan ketemu
                    balek {"status": "RUNTIME_ERROR_UNDECLARED_ASSIGNMENT", "nama": stmt["nama"], "output": output, "lingkungan": lingkungan}
                selesai njir
                lingkungan[stmt["nama"]] = nilai
            kampret
                output = output + [nilai]
            selesai njir
        selesai njir
        i = i + 1
    selesai mumet
    balek {"status": "OK", "output": output, "lingkungan": lingkungan}
selesai fungsi

lah contoh = "lah x = 12 + 3\nhedeh x # komentar\n"
render_tokens(pindai(contoh))

lah ast = parse_source(pindai("2 + 3 * 4"))
hedeh "PRECEDENCE_" + ast["status"]
njir ast["status"] == "OK"
    hedeh evaluasi(ast["node"], {})
selesai njir

lah ast_group = parse_source(pindai("(2 + 3) * 4"))
hedeh "PARENS_" + ast_group["status"]
njir ast_group["status"] == "OK"
    hedeh evaluasi(ast_group["node"], {})
selesai njir

lah ast_modulo = parse_source(pindai("17 % 5"))
hedeh "MODULO_" + ast_modulo["status"]
njir ast_modulo["status"] == "OK"
    hedeh evaluasi(ast_modulo["node"], {})
selesai njir

lah ast_negative = parse_source(pindai("-3 * 4"))
hedeh "UNARY_" + ast_negative["status"]
njir ast_negative["status"] == "OK"
    hedeh evaluasi(ast_negative["node"], {})
selesai njir

lah ast_invalid = parse_source(pindai("7 %"))
hedeh "INVALID_" + ast_invalid["status"]

lah ast_program = parse_program(pindai("lah x = 2 + 3\nx = x + 4\nhedeh x\nlah y = (x + 1) * 2\nhedeh y\n"))
hedeh "PROGRAM_" + ast_program["status"]
njir ast_program["status"] == "OK"
    lah hasil_program = jalankan_program(ast_program["node"])
    hedeh panjang(ast_program["node"]["statements"])
    hedeh hasil_program["output"][0]
    hedeh hasil_program["output"][1]
    hedeh hasil_program["lingkungan"]["x"]
    hedeh hasil_program["lingkungan"]["y"]
selesai njir

lah ast_assignment_invalid = parse_program(pindai("z = 9\n"))
lah hasil_assignment_invalid = jalankan_program(ast_assignment_invalid["node"])
hedeh "INVALID_ASSIGNMENT_" + hasil_assignment_invalid["status"]

lah ast_program_invalid = parse_program(pindai("lah = 4\n"))
hedeh "INVALID_PROGRAM_" + ast_program_invalid["status"]
selesai jancuk
