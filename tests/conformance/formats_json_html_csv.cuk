jancuk
lah data = {"nama": "Budi", "aktif": benar}
hedeh json_teks(data)
lah pulih = json_baca("{\"nama\":\"Budi\",\"aktif\":true}")
hedeh pulih["nama"]
pulih["nama"] = "Siti"
hedeh pulih["nama"]
hedeh pulih["aktif"]
hedeh html_aman("<b>&\"'")
hedeh csv_baris(["Budi", "kopi, susu", "dia bilang \"hai\""])
lah nested = json_baca("{\"items\":[1,{\"ok\":true}],\"empty\":null}")
hedeh json_teks(nested)
lah multiline = json_baca("\"baris\\nbaru\"")
lah carriage = json_baca("\"a\\rb\"")
hedeh csv_baris([multiline, carriage])
hedeh json_teks({"integer_float": 1.0, "negative_zero": -0.0})
